diff --git a/ios/Chatty/ChattyApp.swift b/ios/Chatty/ChattyApp.swift
index 0037165..ef628c0 100644
--- a/ios/Chatty/ChattyApp.swift
+++ b/ios/Chatty/ChattyApp.swift
@@ -5,11 +5,27 @@ struct ChattyApp: App {
     var body: some Scene {
         WindowGroup {
             #if CHATTY_FIXTURE
-            if ProcessInfo.processInfo.arguments.contains("--p0-preview") { FixtureRootView() }
-            else { AppBootstrap(configuration: .fixture) }
+            // Experiment harness (CLE-84 design validation, fixture-only):
+            // `--design-lab-regular` forces a regular horizontal size class so the
+            // proposed regular-width layout can be captured on a simulator whose
+            // default window is compact. Never compiled into the Chatty target.
+            if ProcessInfo.processInfo.arguments.contains("--design-lab-regular") {
+                bootstrap.environment(\.horizontalSizeClass, .regular)
+            } else {
+                bootstrap
+            }
             #else
-            AppBootstrap(configuration: .production)
+            bootstrap
             #endif
         }
     }
+
+    @ViewBuilder private var bootstrap: some View {
+        #if CHATTY_FIXTURE
+        if ProcessInfo.processInfo.arguments.contains("--p0-preview") { FixtureRootView() }
+        else { AppBootstrap(configuration: .fixture) }
+        #else
+        AppBootstrap(configuration: .production)
+        #endif
+    }
 }
