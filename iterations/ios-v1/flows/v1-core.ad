# Synthetic V1 end-to-end flow. Run against a fresh scripts/ios-fixture.py after logging out.
context platform=ios device="iPhone 17 Pro" kind=simulator theme=unknown
open "ai.chatty.ios.fixture"
wait "id=\"auth.email\""
fill "id=\"auth.email\"" "ios@example.test"
press "id=\"auth.sendCode\""
fill "id=\"auth.code\"" 999999
press "id=\"auth.verify\""
wait "id=\"auth.error\""
screenshot "iterations/ios-v1/evidence/v1/login-invalid.png"
fill "id=\"auth.code\"" 123456
press "id=\"auth.verify\""
wait "id=\"workspace.w2\""
press "id=\"workspace.w1\""
wait "id=\"attachment.file1\""
screenshot "iterations/ios-v1/evidence/v1/chat.png"
press "id=\"attachment.file1\""
wait "label=\"Chatty attachment preview OK\""
screenshot "iterations/ios-v1/evidence/v1/file-preview.png"
press "id=\"preview.close\""
fill "id=\"chat.draft\"" "IOS_V1_LOOP_ONE"
press "id=\"chat.send\""
wait "label=\"CHATTY_CHAT_OK · IOS_V1_LOOP_ONE\""
fill "id=\"chat.draft\"" "IOS_V1_LOOP_TWO"
press "id=\"chat.send\""
wait "label=\"CHATTY_CHAT_OK · IOS_V1_LOOP_TWO\""
wait "label=\"CHATTY_CHAT_OK · IOS_V1_LOOP_TWO\""
press "role=\"button\" label=\"收起键盘\""
press "id=\"trace.t2\""
screenshot "iterations/ios-v1/evidence/v1/chat-reply.png"
press "role=\"button\" label=\"项目\""
press "id=\"project.p1\""
press "id=\"issue.i0\""
press "id=\"issue.status\""
press "label=\"内部验收\""
press "id=\"issue.save\""
wait "label=\"内部验收\""
screenshot "iterations/ios-v1/evidence/v1/issue-updated.png"
back
scroll "bottom"
press "id=\"issues.more\""
scroll "bottom"
wait "id=\"issue.i54\""
screenshot "iterations/ios-v1/evidence/v1/issues-55.png"
scroll "top"
wait "label=\"已加载 55 / 55\""
press "id=\"issues.filter\""
press "label=\"内部验收\""
wait "label=\"已加载 1 / 1\""
back
press "id=\"projects.unassigned\""
wait "id=\"issue.orphan\""
press "role=\"button\" label=\"设置\""
press "id=\"settings.signOut\""
wait stable 1000 10000
press "role=\"button\" label=\"退出登录\""
wait "id=\"auth.email\""
close
